{
  "name": "Frame",
  "short_name": "Frame",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "background_color": "#000000",
  "theme_color": "#121212",
  "description": "Frame CAD/CAE workspace",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./frame-icon-192-v4.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./frame-icon-512-v4.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./frame-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/x-frame-hash": [
          ".hash"
        ]
      },
      "icons": [
        {
          "src": "./frame-hash-256-v4.png",
          "sizes": "256x256",
          "type": "image/png"
        }
      ],
      "launch_type": "multiple-clients"
    }
  ]
}
